generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  REJECTED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
}

model CustomerProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address       String?
  preferredCity String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  bookings Booking[]
  reviews  Review[]
}

model ProviderProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceYears Int     @default(0)
  ratingAvg       Float   @default(0.0)
  isAvailable     Boolean @default(true)
  bio             String?
  serviceCity     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  services ServiceOffered[]
  bookings Booking[]
  reviews  Review[]
}

model ServiceCategory {
  id           String  @id @default(uuid())
  categoryName String  @unique
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  services             ServiceOffered[]
  knowledgeBaseEntries KnowledgeBaseEntry[]
}

model ServiceOffered {
  id          String   @id @default(uuid())
  providerId  String
  categoryId  String
  serviceName String
  description String?
  basePrice   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookings Booking[]

}

model KnowledgeBaseEntry {
  id              String @id @default(uuid())
  categoryId      String
  symptomKeywords String

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Booking {
  id                  String        @id @default(uuid())
  customerId          String
  providerId          String?
  serviceId           String?
  rawIssueDescription String
  aiGeneratedJobDesc  String?
  aiEstimatedPriceMin Float?
  aiEstimatedPriceMax Float?
  bookingDate         DateTime      @default(now())
  scheduledTime       String?
  status              BookingStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  customer CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  service  ServiceOffered?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  review   Review?
}

model Review {
  id           String   @id @default(uuid())
  bookingId    String   @unique
  customerId   String
  providerId   String
  rating       Int
  feedbackText String?
  createdAt    DateTime @default(now())

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}
